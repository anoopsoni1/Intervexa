# Backend API base URL (no trailing slash). Vite exposes only vars prefixed with VITE_
VITE_API_BASE_URL=https://intervexa.onrender.com
# On Vercel: set VITE_USE_SAME_ORIGIN_API=true so requests use /api/... (proxied in vercel.json). Avoids client DNS errors to onrender.
# Optional if same-origin API: VITE_SOCKET_URL=https://intervexa.onrender.com
# Optional: canonical / OG base (no trailing slash). Falls back to production domain in SEO.jsx
# VITE_SITE_ORIGIN=https://intervexa.co-vid.in
